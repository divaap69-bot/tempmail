# =============================================
# Email Inbox Dashboard — Environment Variables
# =============================================
# Salin file ini menjadi .env.local dan isi nilainya

# ----- Auth -----
# Kunci rahasia untuk NextAuth (generate dengan: openssl rand -base64 32)
NEXTAUTH_SECRET=ganti-dengan-string-acak-panjang

# URL website kamu (lokal: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Password admin untuk login ke dashboard
ADMIN_PASSWORD=password-rahasia-kamu

# Email username untuk login (bisa apa saja)
ADMIN_EMAIL=admin@domain.com

# ----- Webhook -----
# Secret untuk autentikasi request dari Cloudflare Worker
WEBHOOK_SECRET=ganti-dengan-secret-acak

# ----- Database -----
# Path ke file SQLite (default: ./data/emails.db)
DATABASE_PATH=./data/emails.db
